[Unit]
Description=FieldStation42 On-Screen Display
After=fs42.service
PartOf=fs42.service

[Service]
Type=simple
WorkingDirectory=__INSTALL_DIR__
Environment="DISPLAY=:0"
ExecStartPre=/usr/bin/timeout 120 /bin/bash -c 'until [ -S /tmp/.X11-unix/X0 ]; do sleep 1; done'
ExecStartPre=/bin/sleep 10
ExecStart=__INSTALL_DIR__/env/bin/python3 fs42/osd/main.py
Restart=always
RestartSec=5
StandardOutput=null
StandardError=null

[Install]
WantedBy=default.target
