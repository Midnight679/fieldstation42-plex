[Unit]
Description=FieldStation42 Field Player
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__INSTALL_DIR__
Environment="DISPLAY=:0"
EnvironmentFile=-%h/.config/fs42/plex.env
ExecStartPre=/usr/bin/timeout 120 /bin/bash -c 'until [ -S /tmp/.X11-unix/X0 ]; do sleep 1; done'
ExecStartPre=/bin/bash -c 'if [ ! -f /tmp/fs42-started ]; then sleep 5; touch /tmp/fs42-started; fi'
ExecStart=__INSTALL_DIR__/env/bin/python3 field_player.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
